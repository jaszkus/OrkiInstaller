#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

expected="$(git config user.email)"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    revs=$(git rev-list "$local_sha" --not --remotes)
  else
    revs=$(git rev-list "$remote_sha..$local_sha")
  fi
  for rev in $revs; do
    author=$(git show -s --format='%ae' "$rev")
    committer=$(git show -s --format='%ce' "$rev")
    if [ "$author" != "$expected" ] || [ "$committer" != "$expected" ]; then
      echo "pre-push: $rev uses $author / $committer, expected $expected" >&2
      status=1
    fi
    if git show -s --format='%B' "$rev" | grep -qiE 'generated with|co-authored-by.*(codebuff|copilot|claude|openai|anthropic|gemini)'; then
      echo "pre-push: $rev carries a bot footer or a co-author trailer" >&2
      status=1
    fi
  done
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused; fix the identities or commit messages above" >&2
  exit 1
fi

cargo xtask test --fast
